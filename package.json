{
  "name": "open-wedding",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "node scripts/cloudflare.mjs --deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "setup": "node scripts/setup.mjs",
    "demo": "node scripts/setup.mjs --demo",
    "cloudflare:setup": "node scripts/cloudflare.mjs",
    "test": "vitest run",
    "verify": "npm run config:check && npm run typecheck && npm test && npm run build",
    "format": "prettier --write app workers content scripts tests docs examples *.ts *.json *.jsonc *.md",
    "format:check": "prettier --check app workers content scripts tests docs examples *.ts *.json *.jsonc *.md",
    "config:check": "node scripts/check-config.mjs",
    "config:schema": "node scripts/check-config.mjs --schema",
    "smoke": "node scripts/smoke.mjs",
    "wedding": "node scripts/wedding.mjs",
    "demo:dev": "npm run demo && react-router dev --mode demo",
    "demo:preview": "node scripts/setup.mjs --demo --quiet && react-router build --mode demo && vite preview --mode demo"
  },
  "dependencies": {
    "@react-email/render": "^2.1.0",
    "@uppy/core": "^6.2.0",
    "@uppy/dashboard": "^6.0.1",
    "@uppy/locales": "^5.3.0",
    "@uppy/xhr-upload": "^6.0.1",
    "better-auth": "^1.7.7",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "i18next": "^26.4.4",
    "isbot": "^5.1.36",
    "lucide-react": "^1.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "resend": "^6.32.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.2",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsonc-parser": "^3.3.1",
    "miniflare": "^5.20261006.2-beta",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  },
  "version": "0.1.0",
  "description": "A modular, bilingual wedding website with invitations, RSVPs, seating and private memories on Cloudflare.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zilun-lin/open-wedding.git"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
